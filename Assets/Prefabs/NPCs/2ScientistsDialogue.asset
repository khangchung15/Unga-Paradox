%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 343f22fbc319f40df97cd7d0984ab6fb, type: 3}
  m_Name: 2ScientistsDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - speakerName: Scientist
    speakerPortrait: {fileID: 381005096, guid: 68ea3e390e0a74f389c540a768b115b1, type: 3}
    text: Soon, you will be the savior of this nation
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: Scientist
    speakerPortrait: {fileID: 381005096, guid: 68ea3e390e0a74f389c540a768b115b1, type: 3}
    text: You will liberate the people and restore the city to its glory
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: G-09
    speakerPortrait: {fileID: 381005096, guid: 68ea3e390e0a74f389c540a768b115b1, type: 3}
    text: What are you?
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: Scientist
    speakerPortrait: {fileID: 381005096, guid: 68ea3e390e0a74f389c540a768b115b1, type: 3}
    text: Oh, didn't see you there
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: Scientist
    speakerPortrait: {fileID: 381005096, guid: 68ea3e390e0a74f389c540a768b115b1, type: 3}
    text: I am your creator, you are a clone of mine
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: Scientist
    speakerPortrait: {fileID: 381005096, guid: 68ea3e390e0a74f389c540a768b115b1, type: 3}
    text: Seeing that you are here, my guess is you have finished the mission?
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: Scientist
    speakerPortrait: {fileID: 381005096, guid: 68ea3e390e0a74f389c540a768b115b1, type: 3}
    text: Then join me on the balcony up there
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  autoProgressLines: 
  autoProgressDelay: 1.5
  defaultVoiceSound: {fileID: 0}
  defaultVoicePitch: 1
  defaultTypingSpeed: 0.05
