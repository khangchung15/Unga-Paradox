  m_Script: {fileID: 11500000, guid: 343f22fbc319f40df97cd7d0984ab6fb, type: 3}
  m_Name: 2ScientistsDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - speakerName: Cyber Cop
    speakerPortrait: {fileID: -1569934834, guid: d826385b0073d2f47b5664fe633a2240, type: 3}
    text: My Lord, he got away in his time machine
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: Commander Voras
    speakerPortrait: {fileID: -7206288168892714318, guid: 5760e7bf7ce9a9c4d809d3c57eaa0425, type: 3}
    text: Part of you still believe the clone can save the people of this nation
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: Commander Voras
    speakerPortrait: {fileID: -7206288168892714318, guid: 5760e7bf7ce9a9c4d809d3c57eaa0425, type: 3}
    text: Maybe that's why you were hesitant to capture him.
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  - speakerName: Commander Voras
    speakerPortrait: {fileID: -7206288168892714318, guid: 5760e7bf7ce9a9c4d809d3c57eaa0425, type: 3}
    text: If you can't be my followers, then you shall be an example
    voiceSound: {fileID: 8300000, guid: 5c360740b2aeb45a09a180abf0fe5beb, type: 3}
    voicePitch: 1
    typingSpeed: 0.05
  autoProgressLines: 
  autoProgressDelay: 1.5
  defaultVoiceSound: {fileID: 0}
  defaultVoicePitch: 1
  defaultTypingSpeed: 0.05
